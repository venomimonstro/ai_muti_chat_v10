{$APP_DOMAIN} {
    encode zstd gzip

    # Backend accepts files up to 20 MiB; keep a small multipart envelope but reject
    # oversized bodies before they consume Django/worker memory.
    request_body {
        max_size 25MB
    }

    handle /static/* {
        root * /srv
        file_server
    }

    # Chat is a long-lived SSE transport. Do not depend on reverse-proxy buffering
    # heuristics: flush each provider/recovery/heartbeat event immediately so slow or
    # mobile networks see progress and the frontend reconnect timer is not triggered by
    # proxy-side batching.
    @chatStream path_regexp chatStream ^/api/v1/conversations/[^/]+/messages/stream/$
    handle @chatStream {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {remote_host}
            flush_interval -1
        }
    }

    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle /v1/* {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle /admin/* {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle {
        reverse_proxy frontend:3000
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
