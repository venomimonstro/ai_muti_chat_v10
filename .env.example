DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_SSL_HEADER=false
ADMIN_MFA_ENFORCED=false
MFA_ENCRYPTION_KEY=
MFA_RECOVERY_PEPPER=
LEGAL_DOC_VERSION=2026-09-18
LEGAL_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_EFFECTIVE_DATE=
DATABASE_URL=postgresql://aiworkspace:aiworkspace@postgres:5432/aiworkspace
DATABASE_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
SYSTEM_ISSUE_LOG_FILE=/app/logs/system_issues.jsonl
SYSTEM_ISSUE_LOG_MAX_BYTES=20971520
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.test
SIGNUP_PROMO_RUB=25.00
SIGNUP_PROMO_DAILY_CAP_RUB=1000.00
# Hard owner-side spend ceilings. User preferences may lower them, but cannot raise them.
# Set a value to 0 only if you intentionally disable that system ceiling.
CONSUMER_MAX_SINGLE_REQUEST_RUB=5000
CONSUMER_MAX_DAILY_SPEND_RUB=20000
CONSUMER_MAX_MONTHLY_SPEND_RUB=100000
# Limits rapid start/cancel/timeout loops that could create upstream spend while customer reservations are released.
CONSUMER_MAX_OPERATIONS_PER_MINUTE=20
CHAT_CONFIRM_THRESHOLD_RUB=20.00
# Dedicated verified production smoke account. Keep a small positive balance; never use an admin account.
E2E_USERNAME=
E2E_PASSWORD=
AI_PROVIDER_TIMEOUT_SECONDS=120
AI_PROVIDER_MAX_ATTEMPTS=2
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60
AI_PROVIDER_HEALTH_MAX_AGE_SECONDS=900
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_DEFAULT_MODEL=
# Bootstrap prices are reviewed provider costs in RUB per 1M tokens. Leave blank until reviewed.
AI_PRICE_OPENAI_DEFAULT_INPUT_RUB_PER_MILLION=
AI_PRICE_OPENAI_DEFAULT_OUTPUT_RUB_PER_MILLION=
AI_PRICE_ANTHROPIC_DEFAULT_INPUT_RUB_PER_MILLION=
AI_PRICE_ANTHROPIC_DEFAULT_OUTPUT_RUB_PER_MILLION=
AI_PRICE_DEEPSEEK_DEFAULT_INPUT_RUB_PER_MILLION=
AI_PRICE_DEEPSEEK_DEFAULT_OUTPUT_RUB_PER_MILLION=
AI_PRICE_GEMINI_DEFAULT_INPUT_RUB_PER_MILLION=
AI_PRICE_GEMINI_DEFAULT_OUTPUT_RUB_PER_MILLION=
AI_PRICE_XAI_DEFAULT_INPUT_RUB_PER_MILLION=
AI_PRICE_XAI_DEFAULT_OUTPUT_RUB_PER_MILLION=
FILE_MAX_UPLOAD_BYTES=20971520
FILE_MAX_UNCOMPRESSED_BYTES=104857600
FILE_MAX_ARCHIVE_ENTRIES=1000
FILE_MAX_COMPRESSION_RATIO=100
FILE_MAX_EXTRACTED_CHARS=2000000
FILE_MAX_PDF_PAGES=300
FILE_CHUNK_CHARS=4000
FILE_CHUNK_OVERLAP_CHARS=200
# Protect worker CPU/RAM from upload-delete loops and parallel parsing abuse.
FILE_UPLOADS_PER_MINUTE=10
FILE_UPLOADS_PER_DAY=200
FILE_USER_MAX_ACTIVE_PROCESSING=4
FILE_USER_STORAGE_LIMIT_BYTES=536870912
FILE_PROJECT_STORAGE_LIMIT_BYTES=268435456
FILE_USER_MAX_FILES=1000
FILE_PROJECT_MAX_FILES=500
RAG_SEMANTIC_MODEL=intfloat/multilingual-e5-small
RAG_VECTOR_WEIGHT=0.65
RAG_LEXICAL_WEIGHT=0.35
HISTORY_EMBEDDING_MODEL=local-history-hash-v1
SEARCH_VECTOR_WEIGHT=0.50
SEARCH_LEXICAL_WEIGHT=0.40
SEARCH_RECENCY_WEIGHT=0.10
SEARCH_RETRIEVAL_SCAN_LIMIT=500
SEARCH_MIN_SEMANTIC_SCORE=0.10
WEB_SEARCH_BASE_URL=
WEB_TOOL_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_RESULTS=8
COMPARE_ENABLED=true
COMPARE_MAX_MODELS=4
COMPARE_MAX_OUTPUT_TOKENS=1024
COMPARE_CONFIRM_THRESHOLD_RUB=20.00
IMAGES_ENABLED=true
IMAGE_MAX_PROMPT_CHARS=4000
IMAGE_MAX_RESULT_BYTES=20971520
IMAGE_CONFIRM_THRESHOLD_RUB=20.00
IMAGE_PROVIDER_QUALITY_FAILURE_THRESHOLD=3
IMAGE_PROVIDER_QUALITY_WINDOW_MINUTES=60
# Image Studio: exact provider model ID and reviewed provider cost in RUB per image.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_PRICE_RUB=
OPENAI_IMAGE_SIZES=1024x1024
OPENAI_IMAGE_QUALITIES=standard
OPENAI_IMAGE_MAX_IMAGES=1
OPENAI_IMAGE_MARKUP_PERCENT=100
B2B_API_ENABLED=true
B2B_API_KEY_PEPPER=replace-with-a-dedicated-random-secret
B2B_API_MAX_OUTPUT_TOKENS=4096
B2B_API_MAX_MESSAGE_CHARS=100000
B2B_API_RUNNING_TIMEOUT_SECONDS=600
B2B_TRUST_PROXY_IP_HEADER=false
OPERATION_STALE_TIMEOUT_SECONDS=900
API_ANON_RATE=60/min
API_USER_RATE=300/min
API_LOGIN_RATE=10/min
API_REGISTER_RATE=5/hour
API_CLIENT_ERROR_RATE=10/min
AUTO_MEMORY_ENABLED=false
AUTO_MEMORY_MAX_CANDIDATES=3
PAYMENTS_ENABLED=false
PAYMENTS_LIVE_ENABLED=false
PAYMENT_RECONCILIATION_MAX_AGE_SECONDS=86400
PAYMENT_RETURN_URL=http://localhost:3000/app/wallet/return
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
PAYMENTS_FISCALIZATION_MODE=disabled
PAYMENTS_VAT_CODE=1
PAYMENT_MIN_RUB=100.00
PAYMENT_MAX_RUB=100000.00
# GitHub App integration. Configure Request user authorization (OAuth) during installation.
# Never place a user's PAT here. Keep the app private key only in the server secret store.
GITHUB_INTEGRATION_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_MAX_FILE_BYTES=2097152
GITHUB_MAX_WRITE_BYTES=1048576
GITHUB_MAX_DIRECTORY_ITEMS=1000
# Keep both false in production unless you explicitly accept the data-exposure risk.
GITHUB_ALLOW_SENSITIVE_PATHS=false
GITHUB_ALLOW_SECRET_CONTENT=false
